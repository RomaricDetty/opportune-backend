{
    "name": "opportune-backend",
    "version": "1.0.0",
    "description": "Backend for the E-commerce Website",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "db:create": "node src/scripts/createDatabase.js",
        "db:fix-constraint": "node src/scripts/fixMarqueConstraint.js",
        "db:fix-marques": "node src/scripts/fixMarquesRayonOptionnel.js",
        "db:fix-image-column": "node src/scripts/fixImageColumn.js",
        "db:seed": "node src/scripts/seedDatabase.js",
        "db:seed:force": "node src/scripts/seedDatabase.js --force",
        "db:enrich": "node src/scripts/enrichDemoContent.js",
        "db:migrate": "npx sequelize-cli db:migrate",
        "db:backup": "node src/scripts/backupDb.js",
        "db:backup:verify": "node src/scripts/backupDb.js --verify",
        "db:update": "node src/scripts/dbUpdate.js",
        "db:baseline": "node src/scripts/dbBaseline.js",
        "images:migrate": "node src/scripts/migrateImagesToFiles.js",
        "test": "node --test --test-concurrency=1 tests/*.test.js"
    },
    "keywords": [
        "nodejs",
        "express",
        "sequelize",
        "mysql",
        "ecommerce"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "bcrypt": "^5.1.1",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.1",
        "express-validator": "^7.0.1",
        "helmet": "^8.3.0",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.6.5",
        "nodemailer": "^10.3.1",
        "sequelize": "^6.35.2",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.0",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "nodemon": "^3.0.2",
        "sequelize-cli": "^6.6.2",
        "supertest": "^7.3.1"
    }
}
