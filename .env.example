PORT=3000
NODE_ENV=development

DB_NAME=opportune
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
JWT_CLIENT_EXPIRES_IN=7d

# Origines autorisées (virgules, sans slash final) — obligatoire en production
# Inclure le site Next ET le back-office Vue (http/https, www, ports)
CORS_ORIGIN=http://localhost:3001,http://localhost:5173,http://127.0.0.1:3001,http://127.0.0.1:5173,http://5.182.17.192:6980,http://5.182.17.192:5173,http://5.182.17.192:6984

# 1 = seed auto au démarrage si aucun admin (premier déploiement)
SEED_ON_EMPTY=0

# Adresse publique de l'API : obligatoire derrière un proxy HTTPS (URLs des images)
PUBLIC_API_URL=

# Fichiers envoyés et sauvegardes : à placer sur un volume persistant en production
UPLOADS_DIR=uploads
BACKUP_DIR=backups
BACKUP_KEEP=14

# Alertes e-mail (nouvelles commandes et devis) : laisser vide pour désactiver
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAILS=
